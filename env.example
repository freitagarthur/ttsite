# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_USER=tradetutor
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=tradetutor
# Use a MESMA senha definida em POSTGRES_PASSWORD
DATABASE_URL=postgresql://tradetutor:troque_esta_senha@db:5432/tradetutor

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0

# ---------- Segurança (JWT) ----------
# Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_chave_aleatoria_longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Login com Google (opcional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seudominio.com/api/auth/google/callback

# ---------- URLs ----------
# Endereço público do site (sem barra no final)
FRONTEND_URL=https://seudominio.com
# Deixe /api para usar o mesmo domínio através do Nginx (recomendado)
NEXT_PUBLIC_API_URL=/api

ENVIRONMENT=production
